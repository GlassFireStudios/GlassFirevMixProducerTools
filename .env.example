# Copy to .env (gitignored) and fill in. All values are optional.

# Hub HTTP port (producer views + admin + WebSocket). The tunnel points here.
PORT=8090

# Admin dashboard password. If unset, a strong random password is generated on
# first run and written once to SETUP.md (only its hash is stored on disk).
# ADMIN_PASSWORD=

# Cloudflare API token used ONLY by scripts/provision-tunnel.mjs to create the
# named tunnel + DNS automatically. Needs: Account > Cloudflare Tunnel > Edit,
# Zone > DNS > Edit, Zone > Zone > Read (on glassfire.co).
# CLOUDFLARE_API_TOKEN=

# Optional: pin the Cloudflare account id (otherwise resolved via the API).
# CF_ACCOUNT_ID=

# --- Ingest (MediaMTX) -------------------------------------------------------
# MediaMTX Control API (local only).
# MEDIAMTX_API=http://127.0.0.1:9997
# Loopback port for MediaMTX's HTTP auth hook (authHTTPAddress points here).
# AUTH_HOOK_PORT=8091
# Shown in the dashboard's copy-paste setup: where publishers push, and where
# vMix pulls from inside the VPC.
# INGEST_PUBLIC_HOST=13.216.6.158
# INGEST_PRIVATE_HOST=172.31.79.68
# Networks allowed to READ streams without a key (comma separated CIDRs).
# INGEST_READ_CIDRS=172.31.0.0/16
